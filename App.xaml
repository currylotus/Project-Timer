<Application x:Class="ProjectTimer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <FontFamily x:Key="Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
        <SolidColorBrush x:Key="TextPrimary" Color="#EDF3F6" />
        <SolidColorBrush x:Key="TextMuted" Color="#8C9DA9" />
        <SolidColorBrush x:Key="Accent" Color="#FF9540" />
        <SolidColorBrush x:Key="AccentSoft" Color="#FFB066" />
        <SolidColorBrush x:Key="Danger" Color="#F87171" />
        <SolidColorBrush x:Key="LampIdle" Color="#FF5A5F" />
        <SolidColorBrush x:Key="LampActive" Color="#FFC24A" />
    </Application.Resources>
</Application>